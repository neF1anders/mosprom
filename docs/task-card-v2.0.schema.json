{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mosprom.local/schemas/task-card-2.0.json",
  "$defs": {
    "Assumption": {
      "additionalProperties": false,
      "properties": {
        "text": {
          "title": "Text",
          "type": "string"
        },
        "basis": {
          "default": "",
          "title": "Basis",
          "type": "string"
        },
        "consequence": {
          "default": "",
          "title": "Consequence",
          "type": "string"
        }
      },
      "required": [
        "text"
      ],
      "title": "Assumption",
      "type": "object"
    },
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "title": "Source Id",
          "type": "string"
        },
        "quote": {
          "default": "",
          "title": "Quote",
          "type": "string"
        },
        "page": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Page"
        },
        "method": {
          "anyOf": [
            {
              "enum": [
                "text",
                "vision",
                "user",
                "knowledge"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Method"
        },
        "artifact_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Artifact Id"
        }
      },
      "required": [
        "source_id"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "Geometry": {
      "additionalProperties": false,
      "description": "Summary of the analyzer report; the full report travels as StlAnalysis.",
      "properties": {
        "readable": {
          "default": false,
          "title": "Readable",
          "type": "boolean"
        },
        "units": {
          "default": "unknown",
          "title": "Units",
          "type": "string"
        },
        "extents": {
          "items": {
            "type": "number"
          },
          "title": "Extents",
          "type": "array"
        },
        "watertight": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Watertight"
        },
        "components": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Components"
        },
        "defects": {
          "items": {
            "type": "string"
          },
          "title": "Defects",
          "type": "array"
        },
        "surface_area": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Surface Area"
        },
        "volume": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Volume"
        },
        "volume_basis": {
          "default": "",
          "title": "Volume Basis",
          "type": "string"
        },
        "min_wall_sample": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Min Wall Sample"
        },
        "sections": {
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "title": "Sections",
          "type": "array"
        },
        "limitations": {
          "items": {
            "type": "string"
          },
          "title": "Limitations",
          "type": "array"
        },
        "report_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Report Id"
        },
        "preview_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Preview Id"
        }
      },
      "title": "Geometry",
      "type": "object"
    },
    "Question": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "units",
            "purpose",
            "clarify",
            "verify",
            "discrepancy"
          ],
          "title": "Kind",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "impact": {
          "default": "",
          "title": "Impact",
          "type": "string"
        },
        "options": {
          "items": {
            "type": "string"
          },
          "title": "Options",
          "type": "array"
        },
        "suggested": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Suggested"
        },
        "basis": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Basis"
        },
        "sources": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "title": "Sources",
          "type": "array"
        },
        "requirement_key": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Requirement Key"
        },
        "blocking": {
          "default": true,
          "title": "Blocking",
          "type": "boolean"
        },
        "answer": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Answer"
        }
      },
      "required": [
        "id",
        "kind",
        "title"
      ],
      "title": "Question",
      "type": "object"
    },
    "Requirement": {
      "additionalProperties": false,
      "properties": {
        "key": {
          "title": "Key",
          "type": "string"
        },
        "label": {
          "default": "",
          "title": "Label",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "string"
        },
        "unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit"
        },
        "conditions": {
          "default": "",
          "title": "Conditions",
          "type": "string"
        },
        "mandatory": {
          "default": true,
          "title": "Mandatory",
          "type": "boolean"
        },
        "provenance": {
          "default": "document",
          "enum": [
            "user",
            "document",
            "knowledge",
            "assumption"
          ],
          "title": "Provenance",
          "type": "string"
        },
        "sources": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "title": "Sources",
          "type": "array"
        },
        "verified": {
          "default": false,
          "title": "Verified",
          "type": "boolean"
        },
        "superseded": {
          "items": {
            "$ref": "#/$defs/Superseded"
          },
          "title": "Superseded",
          "type": "array"
        }
      },
      "required": [
        "key",
        "value"
      ],
      "title": "Requirement",
      "type": "object"
    },
    "SourceFile": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "filename": {
          "title": "Filename",
          "type": "string"
        },
        "kind": {
          "title": "Kind",
          "type": "string"
        },
        "sha256": {
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "id",
        "filename",
        "kind",
        "sha256"
      ],
      "title": "SourceFile",
      "type": "object"
    },
    "StlAnalysis": {
      "additionalProperties": false,
      "properties": {
        "attachment_id": {
          "title": "Attachment Id",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "report": {
          "additionalProperties": true,
          "title": "Report",
          "type": "object"
        }
      },
      "required": [
        "attachment_id",
        "sha256",
        "report"
      ],
      "title": "StlAnalysis",
      "type": "object"
    },
    "Superseded": {
      "additionalProperties": false,
      "properties": {
        "value": {
          "title": "Value",
          "type": "string"
        },
        "unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit"
        },
        "sources": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "title": "Sources",
          "type": "array"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "value",
        "reason"
      ],
      "title": "Superseded",
      "type": "object"
    },
    "WaivedQuestion": {
      "additionalProperties": false,
      "description": "A question the checker chose not to ask, and why; the user may still answer otherwise.",
      "properties": {
        "title": {
          "title": "Title",
          "type": "string"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "title",
        "reason"
      ],
      "title": "WaivedQuestion",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "default": "2.0",
      "title": "Schema Version",
      "type": "string"
    },
    "job_id": {
      "title": "Job Id",
      "type": "string"
    },
    "revision": {
      "title": "Revision",
      "type": "integer"
    },
    "purpose": {
      "default": "",
      "title": "Purpose",
      "type": "string"
    },
    "requirements": {
      "items": {
        "$ref": "#/$defs/Requirement"
      },
      "title": "Requirements",
      "type": "array"
    },
    "preferences": {
      "items": {
        "type": "string"
      },
      "title": "Preferences",
      "type": "array"
    },
    "production_constraints": {
      "items": {
        "type": "string"
      },
      "title": "Production Constraints",
      "type": "array"
    },
    "assumptions": {
      "items": {
        "$ref": "#/$defs/Assumption"
      },
      "title": "Assumptions",
      "type": "array"
    },
    "unknowns": {
      "items": {
        "type": "string"
      },
      "title": "Unknowns",
      "type": "array"
    },
    "questions": {
      "items": {
        "$ref": "#/$defs/Question"
      },
      "title": "Questions",
      "type": "array"
    },
    "waived": {
      "items": {
        "$ref": "#/$defs/WaivedQuestion"
      },
      "title": "Waived",
      "type": "array"
    },
    "geometry": {
      "anyOf": [
        {
          "$ref": "#/$defs/Geometry"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "stl_analysis": {
      "anyOf": [
        {
          "$ref": "#/$defs/StlAnalysis"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "readiness": {
      "default": "blocked",
      "enum": [
        "ready",
        "preliminary",
        "blocked"
      ],
      "title": "Readiness",
      "type": "string"
    },
    "allowed_actions": {
      "items": {
        "type": "string"
      },
      "title": "Allowed Actions",
      "type": "array"
    },
    "blocked_actions": {
      "additionalProperties": {
        "items": {
          "type": "string"
        },
        "type": "array"
      },
      "title": "Blocked Actions",
      "type": "object"
    },
    "files": {
      "items": {
        "$ref": "#/$defs/SourceFile"
      },
      "title": "Files",
      "type": "array"
    },
    "versions": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Versions",
      "type": "object"
    }
  },
  "required": [
    "job_id",
    "revision"
  ],
  "title": "TaskCard",
  "type": "object"
}
