# Только для запуска из исходников без плагина. В портативной сборке плагин задаёт всё сам.
# Пусто значит app.db в DATA_DIR.
DATABASE_URL=
DATA_DIR=./artifacts/stage1
QWEN_BASE_URL=https://api.timeweb.ai/v1
QWEN_MODEL=dashscope/qwen3.8-flash
QWEN_API_KEY=
APP_ORIGIN=http://localhost:8000
# Generate a secret with python -c 'import secrets; print(secrets.token_urlsafe(32))'
SESSION_SECRET=
# Folder of STE Slicer's AI Assistant plugin with its server.json, usually
# Documents/STE_AIAssistant in the user's home.
SLICER_HOST_FOLDER=
