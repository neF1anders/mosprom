{
  "note": "Free text of the stage-1 task card that parameter selection reads. Requirement codes, kinds and units come from knowledge/requirement_keys.json. Phrases are regular expressions searched in lowercase free text; \\b marks a word boundary, so a stem matches only at the start of a word. load_phrases is checked in order, first match wins. part_class_phrases read the card purpose when stage 1 gave no part_class code: the class named first in the text wins, as the purpose starts with the name of the part.",
  "booleans": {
    "true": ["true", "да", "yes", "требуется", "обязательно"],
    "false": ["false", "нет", "no", "не требуется"]
  },
  "load_phrases": [
    ["none", ["\\bне несёт", "\\bне несет", "\\bбез нагруз", "\\bне рассчитан"]],
    ["impact", ["\\bудар", "\\bimpact"]],
    ["cyclic", ["\\bциклич", "\\bвибрац", "\\bзнакоперемен", "\\bfatigue", "\\bусталост"]],
    ["static", ["\\bстатич"]]
  ],
  "priority_phrases": {
    "strength": ["\\bпрочн"],
    "accuracy": ["\\bточн", "\\bдопуск(?:и|а|у|ом|е|ов|ам|ами|ах)?\\b"],
    "speed": ["\\bбыстр", "\\bсрочн"],
    "cost": ["\\bдешев", "\\bдёшев", "\\bэконом"]
  },
  "part_class_phrases": {
    "impeller_fan": ["\\bрабоч\\w* колес", "\\bкрыльчат", "\\bимпеллер", "\\bвентилятор"],
    "gear": ["\\bшестер", "\\bзубчат"],
    "shaft": ["\\bвал\\b", "\\bвал(?:а|ы|ов|ик)\\b", "\\bось\\b", "\\bкулач", "\\bкопир"],
    "wheel_roller": ["\\bколес", "\\bролик", "\\bшкив", "\\bкаток"],
    "bushing_sleeve": ["\\bвтулк", "\\bгильз"],
    "housing_bracket": ["\\bкорпус", "\\bкронштейн", "\\bдержател", "\\bкрышк"],
    "cover_boot_seal": ["\\bпыльник", "\\bчехол", "\\bуплотн", "\\bманжет", "\\bсильфон", "\\bпрокладк"],
    "decorative": ["\\bдекоратив", "\\bфигурк", "\\bстатуэт", "\\bсувенир"]
  },
  "supports_forbidden_phrases": ["\\bбез поддерж", "\\bбез опор", "\\bбез следов поддерж"]
}
