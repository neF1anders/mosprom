{
  "note": "t=0: cheap/fast/brittle, t=1: costly/slow/strong. The start point is the value the slicer would use anyway (quality profile, material, definition); rules move t from there. `baseline` names where that value comes from. A discrete setting starts at the slicer value of `key` in the chosen mode, with a definition formula evaluated (infill_pattern from the density, adhesion_type from the mode). Keys are the source keys of the slicer: mode variants (*_classic, *_cylindrical) follow them by formula, except where `mode_keys` names the key to send in each mode.",
  "params": [
    {
      "id": "layer_height",
      "key": "layer_height",
      "unit": "mm",
      "kind": "float",
      "step": 0.01,
      "v0": {"ref": "profile.nozzle_mm", "mul": 0.8},
      "v1": 0.06,
      "baseline": {"quality_layer": true}
    },
    {
      "id": "wall_line_count",
      "key": "wall_thickness",
      "unit": "mm",
      "kind": "int",
      "step": 1,
      "v0": 2,
      "v1": 6,
      "baseline": {"setting": "wall_thickness", "as": "wall_lines"},
      "emit_as": "wall_thickness_from_lines"
    },
    {
      "id": "skin_thickness",
      "key": "top_bottom_thickness",
      "unit": "mm",
      "kind": "float",
      "step": 0.1,
      "v0": 0.8,
      "v1": 2.0,
      "baseline": {"setting": "top_bottom_thickness"}
    },
    {
      "id": "infill_density",
      "key": "infill_sparse_density",
      "unit": "%",
      "kind": "float",
      "step": 5,
      "v0": 10,
      "v1": 60,
      "baseline": {"setting": "infill_sparse_density"}
    },
    {
      "id": "print_temperature",
      "key": "material_print_temperature",
      "unit": "°C",
      "kind": "float",
      "step": 5,
      "v0": {"ref": "material.print_temperature", "add": -10},
      "v1": {"ref": "material.print_temperature", "add": 10},
      "baseline": {"material": "print_temperature"},
      "scope": "extruder:0"
    },
    {
      "id": "print_speed",
      "key": "speed_print",
      "unit": "mm/s",
      "kind": "float",
      "step": 5,
      "v0": {"ref": "profile.defaults.speed_print"},
      "v1": {"ref": "material.speed_floor"},
      "baseline": {"setting": "speed_print"}
    }
  ],
  "discrete": [
    {
      "id": "support_enable",
      "key": "support_enable",
      "candidates": [false, true]
    },
    {
      "id": "infill_pattern",
      "key": "infill_pattern",
      "candidates": ["grid", "lines", "gyroid", "triangles", "cubic", "concentric"]
    },
    {
      "id": "adhesion_type",
      "key": "adhesion_type",
      "candidates": ["brim", "skirt", "raft", "none"]
    },
    {
      "id": "cool_fan_enabled",
      "key": "cool_fan_enabled",
      "mode_keys": {
        "classic": "cool_fan_enabled_classic",
        "cylindrical": "cool_fan_enabled_cylindrical",
        "cylindrical_full": "cool_fan_enabled_cylindrical"
      },
      "candidates": [true, false],
      "scope": "extruder:0"
    },
    {
      "id": "retraction_enable",
      "key": "retraction_enable",
      "candidates": [true, false],
      "scope": "extruder:0"
    }
  ]
}
