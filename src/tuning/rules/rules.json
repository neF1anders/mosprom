{
  "schema": "rules/0",
  "note": "Rules are data. 'when' is a condition tree over flat facts, 'then' a list of actions. Sources: spec section 4.2 (S), STE-Slicer definitions (D), general practice (G, unverified).",
  "rules": [
    {"id": "layer<=0.8*nozzle", "source": "D: fdmprinter layer_height maximum_value_warning", "reason": "layer height must stay below 0.8 of the nozzle diameter",
     "when": {}, "then": [{"op": "limit", "param": "layer_height", "max": {"ref": "profile.nozzle_mm", "mul": 0.8}}]},
    {"id": "layer>=0.10", "source": "S: little gain below 0.10 mm at a large time cost", "reason": "below 0.10 mm quality gain is small and print time grows fast",
     "when": {}, "then": [{"op": "limit", "param": "layer_height", "min": 0.1}]},
    {"id": "walls>=2", "source": "S 4.2", "reason": "at least two perimeters",
     "when": {}, "then": [{"op": "limit", "param": "wall_line_count", "min": 2}]},
    {"id": "top-bottom>=3", "source": "S 4.2", "reason": "at least three top and bottom layers",
     "when": {}, "then": [{"op": "min_layers", "keys": ["top_layers", "bottom_layers"], "min": 3}]},
    {"id": "temp<=machine-max", "source": "D: fdmprinter material_print_temperature maximum_value_warning", "reason": "nozzle temperature must not exceed the machine limit",
     "when": {}, "then": [{"op": "limit", "param": "print_temperature", "max": {"ref": "profile.temperature_max_c"}}]},
    {"id": "temp-in-material-window", "source": "S 4.2; window = catalog nominal +-10 degC (DECISIONS)", "reason": "nozzle temperature stays inside the window around the material file value",
     "when": {}, "then": [
       {"op": "limit", "param": "print_temperature", "min": {"ref": "material.print_temperature", "add": -10}},
       {"op": "limit", "param": "print_temperature", "max": {"ref": "material.print_temperature", "add": 10}}]},

    {"id": "priority-strength", "source": "S 4.2: perimeters give more strength than infill", "reason": "strength is the first priority: stronger perimeters, skins and hotter nozzle",
     "when": {"fact": "pref.priority_first", "op": "==", "value": "strength"},
     "then": [{"op": "shift", "param": "wall_line_count", "delta": 0.2}, {"op": "shift", "param": "skin_thickness", "delta": 0.15},
              {"op": "shift", "param": "infill_density", "delta": 0.1}, {"op": "shift", "param": "print_temperature", "delta": 0.1}]},
    {"id": "priority-speed", "source": "G", "reason": "speed is the first priority: thicker layers, fewer perimeters, faster print",
     "when": {"fact": "pref.priority_first", "op": "==", "value": "speed"},
     "then": [{"op": "shift", "param": "layer_height", "delta": -0.25}, {"op": "shift", "param": "wall_line_count", "delta": -0.15},
              {"op": "shift", "param": "infill_density", "delta": -0.15}, {"op": "shift", "param": "print_speed", "delta": -0.2}]},
    {"id": "priority-accuracy", "source": "G", "reason": "accuracy is the first priority: thinner layers and slower print",
     "when": {"fact": "pref.priority_first", "op": "==", "value": "accuracy"},
     "then": [{"op": "shift", "param": "layer_height", "delta": 0.25}, {"op": "shift", "param": "print_speed", "delta": 0.15}]},
    {"id": "priority-cost", "source": "G", "reason": "cost is the first priority: less infill and fewer perimeters",
     "when": {"fact": "pref.priority_first", "op": "==", "value": "cost"},
     "then": [{"op": "shift", "param": "infill_density", "delta": -0.2}, {"op": "shift", "param": "wall_line_count", "delta": -0.1}]},
    {"id": "load-walls-beat-infill", "source": "S 4.2", "reason": "cyclic or impact load: perimeters carry load better than infill",
     "when": {"fact": "part.load", "op": "in", "value": ["cyclic", "impact"]},
     "then": [{"op": "shift", "param": "wall_line_count", "delta": 0.15}, {"op": "shift", "param": "skin_thickness", "delta": 0.1}]},

    {"id": "tolerance-hard-fine-layer", "source": "G", "reason": "hard tolerance <= 0.15 mm needs thin layers and a slow print",
     "when": {"all": [{"fact": "req.dimensional_tol_mm", "op": "<=", "value": 0.15}, {"fact": "reqhard.dimensional_tol_mm", "op": "==", "value": true}]},
     "then": [{"op": "bound", "param": "layer_height", "min_t": 0.7}, {"op": "bound", "param": "print_speed", "min_t": 0.4}]},
    {"id": "tolerance-soft-fine-layer", "source": "G", "reason": "tolerance wish: prefer thinner layers",
     "when": {"all": [{"fact": "req.dimensional_tol_mm", "op": "exists"}, {"fact": "reqhard.dimensional_tol_mm", "op": "==", "value": false}]},
     "then": [{"op": "shift", "param": "layer_height", "delta": 0.2}]},
    {"id": "stiffness-hard", "source": "S 4.2", "reason": "hard stiffness requirement: at least mid-range perimeters and infill",
     "when": {"all": [{"fact": "req.high_stiffness", "op": "==", "value": true}, {"fact": "reqhard.high_stiffness", "op": "==", "value": true}]},
     "then": [{"op": "bound", "param": "wall_line_count", "min_t": 0.5}, {"op": "bound", "param": "infill_density", "min_t": 0.4}]},
    {"id": "stiffness-soft", "source": "S 4.2", "reason": "stiffness wish: prefer more perimeters and infill",
     "when": {"all": [{"fact": "req.high_stiffness", "op": "==", "value": true}, {"fact": "reqhard.high_stiffness", "op": "==", "value": false}]},
     "then": [{"op": "shift", "param": "wall_line_count", "delta": 0.15}, {"op": "shift", "param": "infill_density", "delta": 0.15}]},
    {"id": "no-visible-layers-hard", "source": "G", "reason": "hard requirement of no visible layers: finest layer height",
     "when": {"all": [{"fact": "req.no_visible_layers", "op": "==", "value": true}, {"fact": "reqhard.no_visible_layers", "op": "==", "value": true}]},
     "then": [{"op": "bound", "param": "layer_height", "min_t": 0.9}]},
    {"id": "no-visible-layers-soft", "source": "G", "reason": "wish for smooth surface: prefer thinner layers",
     "when": {"all": [{"fact": "req.no_visible_layers", "op": "==", "value": true}, {"fact": "reqhard.no_visible_layers", "op": "==", "value": false}]},
     "then": [{"op": "shift", "param": "layer_height", "delta": 0.3}]},
    {"id": "flexible-soft-structure", "source": "G, unverified", "reason": "flexible part: moderate infill and perimeters keep it compliant, slow print feeds elastomers reliably",
     "when": {"fact": "req.flexible", "op": "==", "value": true},
     "then": [{"op": "bound", "param": "infill_density", "max_t": 0.5}, {"op": "bound", "param": "wall_line_count", "max_t": 0.5}, {"op": "bound", "param": "print_speed", "min_t": 0.5}]},

    {"id": "supports-on-overhang", "source": "S 4.2: overhangs above ~45 deg need supports (orientation first, then supports)", "reason": "overhang area above threshold and supports are allowed",
     "when": {"all": [{"fact": "geometry.overhang_area_fraction", "op": ">", "value": 0.05},
                      {"fact": "pref.supports_allowed", "op": "==", "value": true},
                      {"not": {"fact": "reqhard.no_supports", "op": "==", "value": true}}]},
     "then": [{"op": "set_discrete", "param": "support_enable", "value": true}]},
    {"id": "supports-forbidden-overhang", "source": "S 4.2", "reason": "supports are forbidden but the model has overhangs",
     "when": {"all": [{"fact": "geometry.overhang_area_fraction", "op": ">", "value": 0.05},
                      {"fact": "reqhard.no_supports", "op": "==", "value": true}]},
     "then": [{"op": "unsatisfied", "requirement_key": "no_supports", "why": "model has overhanging area above threshold; supports are forbidden, orientation search is needed"}]},
    {"id": "adhesion-brim", "source": "D: fdmprinter default adhesion_type=brim", "reason": "brim is the profile default and limits warping",
     "when": {}, "then": [{"op": "set_discrete", "param": "adhesion_type", "value": "brim"}]},
    {"id": "infill-gyroid-isotropic", "source": "G, unverified", "reason": "impact/cyclic load or flexible part: isotropic gyroid infill",
     "when": {"any": [{"fact": "part.load", "op": "in", "value": ["cyclic", "impact"]}, {"fact": "req.flexible", "op": "==", "value": true}]},
     "then": [{"op": "set_discrete", "param": "infill_pattern", "value": "gyroid"}]},

    {"id": "mode-default-classic", "source": "S 4.3", "reason": "classic is the default printing mode",
     "when": {}, "then": [{"op": "mode_vote", "mode": "classic", "weight": 1.0, "confidence": 0.6}]},
    {"id": "mode-overhang", "source": "S 4.3 hypothesis: 5D avoids supports on overhangs", "reason": "supports forbidden and overhangs present: 5D Spiral may avoid supports (hypothesis, not confirmed by code)",
     "when": {"all": [{"fact": "geometry.overhang_area_fraction", "op": ">", "value": 0.05}, {"fact": "reqhard.no_supports", "op": "==", "value": true}]},
     "then": [{"op": "mode_vote", "mode": "cylindrical", "weight": 2.0, "confidence": 0.35}]},
    {"id": "mode-card-hint", "source": "card", "reason": "printing mode requested in the task card",
     "when": {"fact": "pref.printing_mode", "op": "exists"},
     "then": [{"op": "mode_vote", "mode": {"ref": "pref.printing_mode"}, "weight": 10.0, "confidence": 0.9}]}
  ]
}
